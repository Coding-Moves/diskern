{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Diskern",
  "version": "0.1.0",
  "identifier": "com.diskern.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Diskern",
        "width": 1100,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwODk0OEZFRDk2OUI2MkUKUldRdXRtblova2lKSUhudS9IL0hBNy93UEMyd3FMcGpUOUIrc2xkeHU5YlZLQjJGaHdnMGNOL1AK",
      "endpoints": [
        "https://github.com/Muawiya-contact/diskern/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.png"]
  }
}
